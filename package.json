{
  "name": "payload-obfuscator",
  "private": true,
  "version": "1.0.0",
  "license": "MIT",
  "homepage": "https://payload-obfuscator.dev",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "test": "npm run test:powershell && npm run test:python && npm run test:bash && npm run test:csharp",
    "test:powershell": "node tests/test-powershell.mjs",
    "test:python": "node tests/test-python.mjs",
    "test:bash": "node tests/test-bash.mjs",
    "test:csharp": "node tests/test-csharp.mjs",
    "build": "node scripts/build.mjs",
    "build:full": "node scripts/build.mjs && node scripts/prerender.js",
    "prerender": "node scripts/prerender.js",
    "lint": "eslint .",
    "preview": "vite preview",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist"
  },
  "dependencies": {
    "lucide-react": "^0.312.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-helmet-async": "^3.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^18.2.48",
    "@types/react-dom": "^18.2.18",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.4.17",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "gh-pages": "^6.1.1",
    "globals": "^17.12.0",
    "postcss": "^8.4.33",
    "puppeteer": "^25.10.0",
    "tailwindcss": "^3.4.1",
    "vite": "^8.3.0"
  }
